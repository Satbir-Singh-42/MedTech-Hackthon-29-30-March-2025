# ─── SereneAI Environment Variables ────────────────────────────────────

# Database (optional – app falls back to in-memory storage when absent)
# Neon PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Session secret for Express sessions (auto-generated if missing, but
# sessions won't survive server restarts without a stable value)
# SESSION_SECRET=your-strong-random-secret-here

# Node environment (development | production)
NODE_ENV=development

# Server port (default: 5000)
# PORT=5000
